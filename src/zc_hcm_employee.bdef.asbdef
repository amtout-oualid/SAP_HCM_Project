{
  use update;
  use delete;
  use association _Employee;
}

define behavior for ZC_HCM_Education alias Education
use etag
{
  use update;
  use delete;
  use association _Employee;
}

define behavior for ZC_HCM_Skill alias Skill
use etag
{
  use update;
  use delete;
  use association _Employee;
}

define behavior for ZC_HCM_Emergency alias EmergencyContact
use etag
{
  use update;
  use delete;
  use association _Employee;
}

define behavior for ZC_HCM_Dependent alias Dependent
use etag
{
  use update;
