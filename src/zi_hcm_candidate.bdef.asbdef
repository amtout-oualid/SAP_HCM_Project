managed implementation in class zcl_bp_i_hcm_candidate unique;
strict ( 2 );

define behavior for ZI_HCM_Candidate alias Candidate
persistent table zhcm_candidate
with additional save
lock master
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed )
  CandidateId;

  field ( readonly )
  CreatedAt, LastChangedAt, LocalLastChangedAt;

  // No "features: instance" here!
  action applyToJob parameter ZA_HCM_Apply result [1] $self;

  mapping for zhcm_candidate
  {
    CandidateId            = candidate_id;
    FirstName             = first_name;
    LastName             = last_name;
    Email               = email;
    Phone               = phone;
    Cin                 = cin;
    CreatedAt             = created_at;
    LastChangedAt          = last_changed_at;
    LocalLastChangedAt        = local_last_changed_at;
  }
}