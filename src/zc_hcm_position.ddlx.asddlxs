@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Position',
  typeNamePlural: 'Positions',
  title: { type: #STANDARD, value: 'JobTitle' }
}
annotate view ZC_HCM_Position with
{
  @UI.facet: [{ id: 'PosDetails', type: #IDENTIFICATION_REFERENCE, label: 'Details', position: 10 }]

  @UI.hidden: true
  PositionId;
  
  @UI.hidden: true
  OrgUnitId;

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @Search.defaultSearchElement: true
  JobTitle;

  @UI.lineItem: [{ position: 20, label: 'Is Manager' }]
  @UI.identification: [{ position: 20, label: 'Is Manager' }]
  IsManager;

  @UI.lineItem: [{ position: 30, label: 'FTE' }]
  @UI.identification: [{ position: 30, label: 'Full Time Equivalent (FTE)' }]
  FteValue;

  @UI.lineItem: [{ position: 40, label: 'Status' }]
  @UI.identification: [{ position: 40, label: 'Status' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_HCM_VH_GenericStatus', element: 'Status' } }]
  Status;
}