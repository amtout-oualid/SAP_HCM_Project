@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Pipeline Step',
  typeNamePlural: 'Pipeline Steps'
}
annotate view ZC_HCM_PipeTmpl with
{
  @UI.facet: [{ id: 'StepDetails', type: #IDENTIFICATION_REFERENCE, label: 'Step Details', position: 10 }]
  
  @UI.hidden: true
  TemplateId;
  
  @UI.hidden: true
  OfferId;

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  StepName;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  StepOrder;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  StepType;
}