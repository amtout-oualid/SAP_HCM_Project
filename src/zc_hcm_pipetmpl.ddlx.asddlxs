@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Pipeline Step',
  typeNamePlural: 'Pipeline Steps',
  title: { type: #STANDARD, value: 'StepName' },
  description: { type: #STANDARD, value: 'StepType' }
}
annotate view ZC_HCM_PipeTmpl with
{
  @UI.facet: [{ id: 'StepDetails', type: #IDENTIFICATION_REFERENCE, label: 'Step Details', position: 10 }]
  
  @UI.hidden: true
  TemplateId;
  
  @UI.hidden: true
  OfferId;

  @UI.lineItem: [{ position: 10, label: 'Step Name' }]
  @UI.identification: [{ position: 10, label: 'Step Name' }]
  StepName;

  @UI.lineItem: [{ position: 20, label: 'Order' }]
  @UI.identification: [{ position: 20, label: 'Step Order' }]
  StepOrder;

  @UI.lineItem: [{ position: 30, label: 'Type' }]
  @UI.identification: [{ position: 30, label: 'Step Type' }]
  StepType;

  @UI.lineItem: [{ position: 40, label: 'Changed On' }]
  LocalLastChangedAt;
}