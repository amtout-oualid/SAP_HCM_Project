managed implementation in class zcl_bp_i_hcm_orgunit unique;
strict ( 2 );
with draft;

define behavior for ZI_HCM_OrgUnit alias OrgUnit
persistent table zhcm_orgunit
draft table zhcm_d_orgunit
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
early numbering
{
  create;
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateMandatory;
    validation validateParent;
    validation Position~validatePosition;
  }

  field ( readonly )
    OrgUnitId, OrgUnitNum, ParentUnitName,
    CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) UnitName;

  determination CalculateOrgUnitNum on modify { create; }
  determination DefaultStatus on modify { create; }
  determination setParentUnitName on modify { field ParentOrgUnitId; }
  validation validateMandatory on save { create; update; field UnitName; }
  validation validateDelete on save { delete; }
  validation validateParent on save { create; update; field ParentOrgUnitId; }

  association _Positions { create; with draft; }

  mapping for zhcm_orgunit
  {
    OrgUnitId             = org_unit_id;
    OrgUnitNum            = org_unit_num;
    UnitName              = unit_name;
    Description           = description;
    ParentOrgUnitId       = parent_org_unit_id;
    CostCenter            = cost_center;
    Budget                = budget;
    CurrencyCode          = currency_code;
    Status                = status;
    CreatedBy             = created_by;
    CreatedAt             = created_at;
    LastChangedBy         = last_changed_by;
    LastChangedAt         = last_changed_at;
    LocalLastChangedAt    = local_last_changed_at;
  }
}

define behavior for ZI_HCM_Position alias Position
persistent table zhcm_position
draft table zhcm_d_position
lock dependent by _OrgUnit
authorization dependent by _OrgUnit
etag master LocalLastChangedAt
early numbering
{
  update;
  delete ( features : instance );

  field ( readonly )
    PositionId, OrgUnitId;
  field ( mandatory ) JobTitle;

  determination DefaultPosStatus on modify { create; }
  validation validatePosition on save { create; update; field JobTitle, Status; }

  association _OrgUnit { with draft; }

  mapping for zhcm_position
  {
    PositionId            = position_id;
    OrgUnitId             = org_unit_id;
    JobTitle              = job_title;
    IsManager             = is_manager;
    FteValue              = fte_value;
    Budget                = budget;
    CurrencyCode          = currency_code;
    Status                = status;
    LocalLastChangedAt    = local_last_changed_at;
  }
}
