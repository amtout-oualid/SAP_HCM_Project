@Metadata.layer: #CUSTOMER
@UI.headerInfo: { typeName: 'Skill', typeNamePlural: 'Skills' }
annotate view ZC_HCM_Skill with {
  @UI.hidden: true SkillId;
  @UI.hidden: true EmployeeId;
  @UI.lineItem: [{ position: 10 }] @UI.identification: [{ position: 10 }] SkillName;
  @UI.lineItem: [{ position: 20 }] @UI.identification: [{ position: 20 }] Proficiency;
  @UI.lineItem: [{ position: 30 }] @UI.identification: [{ position: 30 }] CertName;
}