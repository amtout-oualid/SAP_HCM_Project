@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Organizational Unit',
  typeNamePlural: 'Organizational Units',
  title: { type: #STANDARD, value: 'UnitName' }
}
annotate view ZC_HCM_OrgUnit with
{
  @UI.facet: [
    { id: 'OrgDetails', type: #IDENTIFICATION_REFERENCE, label: 'Details', position: 10 },
    { id: 'Positions', type: #LINEITEM_REFERENCE, label: 'Positions', position: 20, targetElement: '_Positions' }
  ]

  @UI.hidden: true
  OrgUnitId;

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @Search.defaultSearchElement: true
  UnitName;

  @UI.identification: [{ position: 20 }]
  ParentOrgUnitId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 30 }]
  @UI.selectionField: [{ position: 20 }]
  @Search.defaultSearchElement: true
  CostCenter;

  @UI.lineItem: [{ position: 30, label: 'Status' }]
  @UI.identification: [{ position: 40, label: 'Status' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_HCM_VH_GenericStatus', element: 'Status' } }]
  Status;
}