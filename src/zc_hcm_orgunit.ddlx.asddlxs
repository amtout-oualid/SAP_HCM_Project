@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Organizational Unit',
  typeNamePlural: 'Organizational Units',
  title: { type: #STANDARD, value: 'UnitName' }
}
annotate view ZC_HCM_OrgUnit with
{
  @UI.facet: [
    { id: 'OrgDetails', type: #IDENTIFICATION_REFERENCE, label: 'Details', position: 10 },
    { id: 'Positions', type: #LINEITEM_REFERENCE, label: 'Positions', position: 20, targetElement: '_Positions' }
  ]

  @UI.hidden: true
  OrgUnitId;

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  UnitName;

  @UI.identification: [{ position: 20 }]
  ParentOrgUnitId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 30 }]
  CostCenter;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 40 }]
  Status;
}