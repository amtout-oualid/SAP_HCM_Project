@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Job Offer',
  typeNamePlural: 'Job Offers',
  title: { type: #STANDARD, value: 'Title' },
  description: { type: #STANDARD, value: 'Department' }
}
annotate view ZC_HCM_JobOffer with
{
  @UI.facet: [
    { id: 'GeneralInfo', type: #IDENTIFICATION_REFERENCE, label: 'General Information', position: 10 },
    { id: 'PipelineSteps', type: #LINEITEM_REFERENCE, label: 'Pipeline Steps', position: 20, targetElement: '_Steps' },
    { id: 'Applications', type: #LINEITEM_REFERENCE, label: 'Applications', position: 30, targetElement: '_Applications' }
  ]

  @UI.hidden: true
  OfferId;

  @UI.lineItem: [{ position: 10, importance: #HIGH, label: 'Title' }, 
                 { type: #FOR_ACTION, dataAction: 'publishOffer', label: 'Publish' }, 
                 { type: #FOR_ACTION, dataAction: 'closeOffer', label: 'Close Offer' }]
  @UI.identification: [{ position: 10, label: 'Job Title' }]
  @Search.defaultSearchElement: true
  Title;

  @UI.identification: [{ position: 20, label: 'Description' }]
  @UI.multiLineText: true
  Description;

  @UI.lineItem: [{ position: 20, label: 'Department' }]
  @UI.identification: [{ position: 30, label: 'Department' }]
  @UI.selectionField: [{ position: 20 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZC_HCM_OrgUnit', element: 'UnitName' } }]
  Department;

  @UI.identification: [{ position: 40, label: 'Required Skills (Comma Separated)' }]
  @UI.multiLineText: true
  RequiredSkills;

  @UI.identification: [{ position: 50, label: 'Experience Level' }]
  ExperienceLevel;

  @UI.identification: [{ position: 60, label: 'Contract Type' }]
  ContractType;

  @UI.identification: [{ position: 70, label: 'Location' }]
  Location;

  @UI.lineItem: [{ position: 40, label: 'Needed' }]
  @UI.identification: [{ position: 80, label: 'Positions Needed' }]
  PositionsNeeded;

  @UI.lineItem: [{ position: 50, label: 'Filled' }]
  @UI.identification: [{ position: 90, label: 'Positions Filled' }]
  PositionsFilled;

  @UI.identification: [{ position: 100, label: 'Minimum Salary' }]
  SalaryMin;

  @UI.identification: [{ position: 110, label: 'Maximum Salary' }]
  SalaryMax;

  @UI.identification: [{ position: 115, label: 'Currency' }]
  CurrencyCode;

  @UI.hidden: true
  Status;

  @UI.lineItem: [{ position: 30, label: 'Status' }]
  @UI.identification: [{ position: 140, label: 'Status' }]
  @UI.selectionField: [{ position: 10 }]
  StatusText;

  @UI.lineItem: [{ position: 60, label: 'Valid Until' }]
  @UI.identification: [{ position: 130, label: 'Valid Until' }]
  ValidUntil;
}