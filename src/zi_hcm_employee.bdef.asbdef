managed implementation in class zcl_bp_i_hcm_employee unique;
strict ( 2 );

define behavior for ZI_HCM_Employee alias Employee
with unmanaged save
lock master
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed )
    EmployeeId;

  field ( readonly )
    HireDate, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  field ( mandatory )
    FirstName, LastName, DateOfBirth, Nationality;

  determination setDefaultStatus on modify { create; }

  association _Contact { create; }
  association _OrgAssign { create; }
  association _LegalContract { create; }
  association _BankDetails { create; }
  association _Education { create; }
  association _Skills { create; }
  association _Emergency { create; }
  association _Dependents { create; }
  association _Documents { create; }

  mapping for zhcm_employee
  {
    EmployeeId            = employee_id;
    FirstName             = first_name;
    LastName             = last_name;
    DateOfBirth            = date_of_birth;
    PlaceOfBirth           = place_of_birth;
    MaritalStatus          = marital_status;
    Nationality            = nationality;
    Gender               = gender;
    EmployeeStatus          = employee_status;
    PhotoUrl             = photo_url;
    HireDate             = hire_date;
    TerminationDate         = termination_date;
    CreatedBy             = created_by;
    CreatedAt             = created_at;
    LastChangedBy          = last_changed_by;
    LastChangedAt          = last_changed_at;
    LocalLastChangedAt        = local_last_changed_at;
  }
}

define behavior for ZI_HCM_Contact alias Contact
persistent table zhcm_contact
lock dependent by _Employee
authorization dependent by _Employee
etag master LocalLastChangedAt
{
  update;
  delete;

  field ( readonly, numbering : managed )
    ContactId;

  field ( readonly )
    EmployeeId;

  association _Employee;

  mapping for zhcm_contact
  {
    ContactId             = contact_id;
    EmployeeId            = employee_id;
    PersonalAddress         = personal_address;
    PhoneNumber            = phone_number;
    PersonalEmail          = personal_email;
    WorkEmail             = work_email;
    LocalLastChangedAt        = local_last_changed_at;
  }
}

