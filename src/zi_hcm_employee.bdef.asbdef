  {
    AssignId             = org_assignment_id;
    EmployeeId            = employee_id;
    PositionId            = position_id;
    OrgUnitId             = org_unit_id;
    JobTitle             = job_title;
    Department            = department;
    ManagerId             = manager_id;
    ValidFrom             = valid_from;
    ValidTo              = valid_to;
    LocalLastChangedAt        = local_last_changed_at;
  }
}

