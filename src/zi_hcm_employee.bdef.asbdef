managed implementation in class zcl_bp_i_hcm_employee unique;
strict ( 2 );
with draft;

define behavior for ZI_HCM_Employee alias Employee
persistent table zhcm_employee
draft table zhcm_employ_d
with additional save
lock master
total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create; update; delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  field ( readonly, numbering : managed ) EmployeeId;
  field ( readonly ) HireDate, EmployeeStatus;

  determination setDefaultStatus on modify { create; }

  action ( features : instance, authorization : instance ) promoteEmployee parameter ZA_HCM_Promote result [1] $self;
  action ( features : instance, authorization : instance ) terminateEmployee parameter ZA_HCM_Terminate result [1] $self;
  action ( features : instance, authorization : instance ) transferEmployee parameter ZA_HCM_Transfer result [1] $self;
  action ( features : instance, authorization : instance ) suspendEmployee result [1] $self;
  action ( features : instance, authorization : instance ) activateEmployee result [1] $self;

  association _Contact { create; with draft; }
  association _BankDetails { create; with draft; }

  mapping for zhcm_employee
  {
    EmployeeId = employee_id;
    FirstName = first_name;
    LastName = last_name;
    DateOfBirth = date_of_birth;
    PlaceOfBirth = place_of_birth;
    MaritalStatus = marital_status;
    Nationality = nationality;
    Gender = gender;
    EmployeeStatus = employee_status;
    PhotoUrl = photo_url;
    HireDate = hire_date;
    TerminationDate = termination_date;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_HCM_Contact alias Contact
persistent table zhcm_contact
draft table zhcm_contct_d
lock dependent by _Employee
authorization dependent by _Employee
etag master LocalLastChangedAt
{
  update; delete;
  field ( readonly, numbering : managed ) ContactId;
  field ( readonly ) EmployeeId;
  association _Employee { with draft; }

  mapping for zhcm_contact
  {
    ContactId = contact_id;
    EmployeeId = employee_id;
    PersonalAddress = personal_address;
    PhoneNumber = phone_number;
    PersonalEmail = personal_email;
    WorkEmail = work_email;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_HCM_BankDetl alias BankDetails
persistent table zhcm_bankdetl
draft table zhcm_bankdt_d
lock dependent by _Employee
authorization dependent by _Employee
etag master LocalLastChangedAt
{
  update; delete;
  field ( readonly, numbering : managed ) BankId;
  field ( readonly ) EmployeeId;
  association _Employee { with draft; }

  mapping for zhcm_bankdetl
  {
    BankId = bank_detail_id;
    EmployeeId = employee_id;
    BankName = bank_name;
    AccountNumber = account_number;
    Iban = iban;
    BicSwift = bic_swift;
    LocalLastChangedAt = local_last_changed_at;
  }
}