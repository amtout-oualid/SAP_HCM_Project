managed implementation in class zcl_bp_i_hcm_talentpool unique;
strict ( 2 );

define behavior for ZI_HCM_TalentPool alias TalentPool
persistent table zhcm_talntpool
lock master
authorization master ( instance )
etag master LocalLastChangedAt
early numbering
{
  create;
  delete;

  field ( readonly )
    PoolId, CandidateId, FirstName, LastName, Email, Cin, ResumeUrl, OriginalOffer, RejectionReason, AddedAt, LocalLastChangedAt;

  mapping for zhcm_talntpool
  {
    PoolId               = pool_id;
    CandidateId            = candidate_id;
    FirstName             = first_name;
    LastName             = last_name;
    Email               = email;
    Cin                 = cin;
    ResumeUrl             = resume_url;
    OriginalOffer          = original_offer;
    RejectionReason         = rejection_reason;
    AddedAt              = added_at;
    LocalLastChangedAt        = local_last_changed_at;
  }
}