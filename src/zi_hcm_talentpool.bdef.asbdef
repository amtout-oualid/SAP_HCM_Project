managed implementation in class zcl_bp_i_hcm_talentpool unique;
strict ( 2 );

define behavior for ZI_HCM_TalentPool alias TalentPool
persistent table zhcm_talntpool
lock master
authorization master ( instance )
etag master LastChangedAt
early numbering
{
  create;
  delete;

  field ( readonly ) PoolId, AddedAt, LastChangedAt;

  mapping for zhcm_talntpool
  {
    PoolId             = pool_id;
    CandidateId        = candidate_id;
    OriginalOfferId    = original_offer_id;
    CandidateName      = candidate_name;
    CandidateEmail     = candidate_email;
    ResumeUrl          = resume_url;
    AiScore            = ai_score;
    Skills             = skills;
    Status             = status;
    AddedAt            = added_at;
    Notes              = notes;
    RejectionReason    = rejection_reason;
    LastChangedAt      = last_changed_at;
  }
}
