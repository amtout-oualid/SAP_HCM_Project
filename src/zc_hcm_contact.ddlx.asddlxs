@Metadata.layer: #CUSTOMER
@UI.headerInfo: { typeName: 'Contact', typeNamePlural: 'Contacts' }
annotate view ZC_HCM_Contact with {
  @UI.hidden: true ContactId;
  @UI.hidden: true EmployeeId;
  @UI.lineItem: [{ position: 10 }] @UI.identification: [{ position: 10 }] PersonalAddress;
  @UI.lineItem: [{ position: 20 }] @UI.identification: [{ position: 20 }] PhoneNumber;
  @UI.lineItem: [{ position: 30 }] @UI.identification: [{ position: 30 }] PersonalEmail;
}