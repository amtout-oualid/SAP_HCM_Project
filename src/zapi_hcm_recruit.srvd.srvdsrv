@EndUserText.label: 'Web API for React Candidate Portal'
define service ZAPI_HCM_RECRUIT {
  expose ZC_HCM_Application as Application;
  expose ZC_HCM_Candidate   as Candidate;
  expose ZC_HCM_Onboarding  as Onboarding;
  expose ZC_HCM_JobOffer    as JobOffer;
  expose ZC_HCM_PipeTmpl    as PipelineStep;
  expose ZI_HCM_Application as ApplicationParameter;
}