@Metadata.layer: #CUSTOMER
@UI.headerInfo: { typeName: 'Emergency Contact', typeNamePlural: 'Emergency Contacts' }
annotate view ZC_HCM_Emergency with {
  @UI.hidden: true EmContactId;
  @UI.hidden: true EmployeeId;
  @UI.lineItem: [{ position: 10 }] @UI.identification: [{ position: 10 }] ContactName;
  @UI.lineItem: [{ position: 20 }] @UI.identification: [{ position: 20 }] Relationship;
  @UI.lineItem: [{ position: 30 }] @UI.identification: [{ position: 30 }] Phone;
}