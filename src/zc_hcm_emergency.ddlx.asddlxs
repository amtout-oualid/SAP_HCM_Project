@Metadata.layer: #CUSTOMER
@UI.headerInfo: { typeName: 'Emergency Contact', typeNamePlural: 'Emergency Contacts',
                  title: { type: #STANDARD, value: 'ContactName' } }
annotate view ZC_HCM_Emergency with {
  @UI.facet: [{ id: 'Details', type: #IDENTIFICATION_REFERENCE, label: 'Emergency Contact', position: 10 }]

  @UI.hidden: true EmContactId;
  @UI.hidden: true EmployeeId;
  @UI.hidden: true LocalLastChangedAt;
  @UI.lineItem: [{ position: 10, label: 'Name' }]         @UI.identification: [{ position: 10, label: 'Name' }]         ContactName;
  @UI.lineItem: [{ position: 20, label: 'Relationship' }] @UI.identification: [{ position: 20, label: 'Relationship' }] Relationship;
  @UI.lineItem: [{ position: 30, label: 'Phone' }]        @UI.identification: [{ position: 30, label: 'Phone' }]        Phone;
  @UI.lineItem: [{ position: 40, label: 'Primary' }]      @UI.identification: [{ position: 40, label: 'Primary' }]      IsPrimary;
}
