managed implementation in class zcl_bp_i_hcm_joboffer unique;
strict ( 2 );
with draft;

define behavior for ZI_HCM_JobOffer alias JobOffer
persistent table zhcm_joboffer
draft table zhcm_d_joboffer
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create; update; delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  field ( readonly, numbering : managed ) OfferId;
  field ( mandatory ) Title, Department;

  action ( features : instance ) publishOffer result [1] $self;
  action ( features : instance ) closeOffer result [1] $self;
  action ( features : instance ) reopenOffer result [1] $self;

  validation validateBeforePublish on save { create; update; }
  validation validateApplicationDeadline on save { create; update; }
  determination autoCloseOnDeadline on save { field AppDeadline; }

  determination setDefaultValues on modify { create; }

  association _Applications { create; with draft; }
  association _Steps { create; with draft; }

  mapping for zhcm_joboffer
  {
    OfferId = offer_id;
    Title = title;
    Description = description;
    Department = department;
    RequiredSkills = required_skills;
    ExperienceLevel = experience_level;
    ContractType = contract_type;
    Location = location;
    PositionsNeeded = positions_needed;
    PositionsFilled = positions_filled;
    SalaryMin = salary_min;
    SalaryMax = salary_max;
    CurrencyCode = currency_code;
    Status = status;
    AppDeadline = app_deadline;
    ValidUntil = valid_until;
    PublishedAt = published_at;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_HCM_Application alias Application
persistent table zhcm_applicatn
draft table zhcm_d_applicatn
lock dependent by _Offer
authorization dependent by _Offer
etag master LocalLastChangedAt
{
  update; delete;
  field ( readonly, numbering : managed ) ApplicationId;
  field ( readonly ) OfferId;

  action evaluateWithAI result [1] $self;
  action passToNextStep result [1] $self;
  action acceptToPost result [1] $self;

  action putOnHold result [1] $self;
  action addNote parameter ZA_HCM_AddNote result [1] $self;
  action rejectCandidate parameter ZA_HCM_Reject result [1] $self;
  action sendMail parameter ZA_HCM_SendMail result [1] $self;

  validation preventDuplicateApplication on save { create; }

  association _Offer { with draft; }

  mapping for zhcm_applicatn
  {
    ApplicationId = application_id;
    OfferId = offer_id;
    CandidateId = candidate_id;
    ResumeUrl = resume_url;
    CoverLetter = cover_letter;
    AppliedAt = applied_at;
    CurrentStepOrder = current_step_order;
    OverallStatus = overall_status;
    AiMatchScore = ai_match_score;
    NoticePeriod = notice_period;
    SalaryExpectation = salary_expectation;
    CurrencyCode = currency_code;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_HCM_PipeTmpl alias PipeTmpl
persistent table zhcm_pipe_tmpl
draft table zhcm_d_pipetmpl
lock dependent by _Offer
authorization dependent by _Offer
etag master LocalLastChangedAt
{
  update; delete;
  field ( readonly, numbering : managed ) TemplateId;
  field ( readonly ) OfferId;

  association _Offer { with draft; }

  mapping for zhcm_pipe_tmpl
  {
    TemplateId = template_id;
    OfferId = offer_id;
    StepName = step_name;
    StepOrder = step_order;
    StepType = step_type;
    StepDescription = step_desc;
    LocalLastChangedAt = local_last_changed_at;
  }
}