managed implementation in class zcl_bp_i_hcm_joboffer unique;
strict ( 2 );

define behavior for ZI_HCM_JobOffer alias JobOffer
persistent table zhcm_joboffer
lock master
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed )
    OfferId;

  field ( readonly )
    PositionsFilled, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  field ( readonly : update )
    Department;

  field ( mandatory : create )
    Title, Department, PositionsNeeded;

  action publishOffer result [1] $self;
  action closeOffer result [1] $self;

  validation validateDates on save { create; field ValidUntil; }
  validation validateSalary on save { create; field SalaryMin, SalaryMax; }

  association _Steps { create; }
  association _Applications { create; }

  mapping for zhcm_joboffer
  {
    OfferId              = offer_id;
    Title               = title;
    Description           = description;
    Department            = department;
    RequiredSkills          = required_skills;
    ExperienceLevel         = experience_level;
    ContractType           = contract_type;
    Location             = location;
    PositionsNeeded         = positions_needed;
    PositionsFilled         = positions_filled;
    SalaryMin             = salary_min;
    SalaryMax             = salary_max;
    CurrencyCode           = currency_code;
    Status               = status;
    ValidUntil            = valid_until;
    CreatedBy             = created_by;
    CreatedAt             = created_at;
    LastChangedBy          = last_changed_by;
    LastChangedAt          = last_changed_at;
    LocalLastChangedAt        = local_last_changed_at;
  }
}

define behavior for ZI_HCM_PipeTmpl alias PipelineStep
persistent table zhcm_pipe_tmpl
lock dependent by _Offer
authorization dependent by _Offer
etag master LocalLastChangedAt
{
  update;
  delete;

  field ( readonly, numbering : managed )
    TemplateId;

  field ( readonly )
    OfferId;

  association _Offer;

  mapping for zhcm_pipe_tmpl
  {
    TemplateId            = template_id;
    OfferId              = offer_id;
    StepName             = step_name;
    StepOrder             = step_order;
    StepType             = step_type;
    LocalLastChangedAt        = local_last_changed_at;
  }
}

define behavior for ZI_HCM_Application alias Application
persistent table zhcm_applicatn
lock dependent by _Offer
authorization dependent by _Offer
etag master LocalLastChangedAt
{
  update;

  field ( readonly, numbering : managed )
    ApplicationId;

  field ( readonly )
    OfferId, AiMatchScore, OverallStatus, CurrentStepOrder, AppliedAt;

  action evaluateWithAI result [1] $self;
  action passToNextStep result [1] $self;
  action rejectCandidate result [1] $self;
  action acceptToPost result [1] $self;

  validation validateCIN on save { create; field CandidateId; }

  association _Progress { create; }
  association _Offer;

  mapping for zhcm_applicatn
  {
    ApplicationId          = application_id;
    OfferId              = offer_id;
    CandidateId            = candidate_id;
    ResumeUrl             = resume_url;
    CoverLetter            = cover_letter;
    AppliedAt             = applied_at;
    CurrentStepOrder         = current_step_order;
    OverallStatus          = overall_status;
    AiMatchScore           = ai_match_score;
    NoticePeriod           = notice_period;
    SalaryExpectation         = salary_expectation;
    CurrencyCode           = currency_code;
    LocalLastChangedAt        = local_last_changed_at;
  }
}

define behavior for ZI_HCM_PipeProg alias PipelineProgress
persistent table zhcm_pipe_prog
lock dependent by _Offer
authorization dependent by _Offer
etag master LocalLastChangedAt
{
  update;

  field ( readonly, numbering : managed )
    ProgressId;

  field ( readonly )
    ApplicationId, StepOrder, StepName, OfferId;

  association _Application;
  association _Offer;

  mapping for zhcm_pipe_prog
  {
    ProgressId            = progress_id;
    ApplicationId          = application_id;
    StepOrder             = step_order;
    StepName             = step_name;
    Status               = status;
    Score               = score;
    Notes               = notes;
    CompletedAt            = completed_at;
    LocalLastChangedAt        = local_last_changed_at;
  }
}