@Metadata.layer: #CUSTOMER
@UI.headerInfo: { typeName: 'Bank Detail', typeNamePlural: 'Bank Details' }
annotate view ZC_HCM_BankDetl with {
  @UI.hidden: true BankId;
  @UI.hidden: true EmployeeId;
  @UI.lineItem: [{ position: 10 }] @UI.identification: [{ position: 10 }] BankName;
  @UI.lineItem: [{ position: 20 }] @UI.identification: [{ position: 20 }] AccountNumber;
  @UI.lineItem: [{ position: 30 }] @UI.identification: [{ position: 30 }] Iban;
}