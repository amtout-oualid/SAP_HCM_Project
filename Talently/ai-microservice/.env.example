# ==============================================================================
# SAP Intern Evaluator API - Environment Configuration (OpenAI GPT API)
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# LLM Model (OpenAI GPT)
# Options: gpt-4o-mini (fast & low cost, recommended), gpt-4o (highest accuracy)
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_ROLE=software_engineering_intern

# OpenAI API Key (REQUIRED - replace with your actual OpenAI API key starting with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Token (Optional but recommended to avoid GitHub API rate limits when analyzing candidate repos)
GITHUB_TOKEN=your_github_token_here

# Persistent CSV export storage path
CSV_EXPORT_PATH=evaluations.csv
