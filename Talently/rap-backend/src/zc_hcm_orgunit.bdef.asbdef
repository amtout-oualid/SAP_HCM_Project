projection;
strict ( 2 );
use draft;

define behavior for ZC_HCM_OrgUnit alias OrgUnit
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Positions { create; with draft; }
}

define behavior for ZC_HCM_Position alias Position
use etag
{
  use update;
  use delete;

  use association _OrgUnit { with draft; }
}